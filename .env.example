# ==============================================================================
# KRAMA Onshape Engineering Connector - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure local values.
# NEVER commit actual API keys or secret credentials to version control.

# Application runtime settings
APP_NAME="KRAMA Onshape Engineering Connector"
APP_VERSION="0.1.0"
DEBUG=false
ENVIRONMENT=development

# Database Configuration
# Local development & tests use SQLite by default:
DATABASE_URL="sqlite:///./krama_connector.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql://user:password@localhost:5432/krama_cad"

# Onshape API Credentials
# Required for live Onshape API requests. If unavailable, test fixtures are used.
ONSHAPE_BASE_URL="https://cad.onshape.com"
ONSHAPE_API_VERSION="v10"
ONSHAPE_ACCESS_KEY="your_onshape_access_key_here"
ONSHAPE_SECRET_KEY="your_onshape_secret_key_here"

# Alternative OAuth2 Authentication (optional)
ONSHAPE_OAUTH_CLIENT_ID=""
ONSHAPE_OAUTH_CLIENT_SECRET=""
ONSHAPE_OAUTH_TOKEN=""

# Target Document Identifiers (Optional defaults)
ONSHAPE_DOCUMENT_ID=""
ONSHAPE_WORKSPACE_ID=""
ONSHAPE_ELEMENT_ID=""

# Change Detection & Sync
POLL_INTERVAL_SECONDS=300
HTTP_TIMEOUT_SECONDS=30.0
HTTP_MAX_RETRIES=3
